{
  "name": "nqv-desktop",
  "version": "0.1.0",
  "description": "Quick-look viewer for NetCDF files: desktop app on the nqv session",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
