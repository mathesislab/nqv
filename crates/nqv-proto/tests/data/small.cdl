// Small test file for the nqv protocol tests: ncgen -k nc4 -o small.nc small.cdl
netcdf small {
dimensions:
	time = UNLIMITED ;
	lat = 6 ;
	lon = 8 ;
variables:
	double time(time) ;
		time:units = "years" ;
	double lat(lat) ;
		lat:units = "degrees_north" ;
	double lon(lon) ;
		lon:units = "degrees_east" ;
	float temp(time, lat, lon) ;
		temp:units = "K" ;
		temp:long_name = "test field: 100 t + lat + lon / 100" ;
		temp:_FillValue = -999.f ;
	int mask(lat, lon) ;
	float series(time) ;
