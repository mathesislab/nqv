{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nqv",
  "version": "0.1.0",
  "identifier": "io.github.mathesislab.nqv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nqv",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "nc",
          "nc4"
        ],
        "mimeType": "application/x-netcdf",
        "name": "NetCDF data",
        "description": "NetCDF data",
        "role": "Viewer"
      }
    ]
  },
  "mainBinaryName": "nqv-desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4Q0M4NTdFNkU1OTVGMDcKUldRSFgxbHVmb1hNV003eVcxOHBOKzJhM2E2SXk0d1hNQjVmWHdLVURrdGZ0VWZYK3lzUUhHWlgK",
      "endpoints": [
        "https://github.com/mathesislab/nqv/releases/latest/download/latest.json"
      ]
    }
  }
}
